# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` — it is git-ignored.
#
# Nothing here is needed yet: the MVP runs entirely on local mock data.

# ── Supabase (future: catalogue, saved items, accounts) ──────────────
# NEXT_PUBLIC_ values are visible in the browser, so only put public keys here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI services (future: visual search, translation) ─────────────────
# Server-only. Called from API routes, never from the browser.
AI_API_KEY=your-ai-provider-key
